{
  "name": "results-dashboard-static",
  "version": "0.1.0",
  "private": true,
  "description": "CGIAR Results Dashboard: static site build and local tooling",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "pretest": "node -e \"process.getBuiltinModule('fs').mkdirSync('reports',{recursive:true})\"",
    "test": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit.xml \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "compare": "node scripts/compare.mjs",
    "evidence": "node scripts/evidence.mjs",
    "freeze": "node scripts/freeze-artifact.mjs",
    "build:infra": "node scripts/build-infra.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "5.2.0",
    "@playwright/test": "1.64.0",
    "animate.css": "3.7.0",
    "bootstrap": "4.1.3",
    "jquery-csv": "1.0.3",
    "twig": "3.0.0",
    "yaml": "2.9.1"
  }
}
